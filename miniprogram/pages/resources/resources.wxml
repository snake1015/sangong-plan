<view class="page">

  <view class="card card-info">
    <view class="card-title">📚 学习资源</view>
    <view class="small muted">小程序内不能直接打开外部网页：点一下条目即可复制链接，再到浏览器 / 微信里粘贴打开。</view>
  </view>

  <view class="section" wx:for="{{groups}}" wx:key="group">
    <view class="section-title">{{item.group}}</view>
    <view class="item" wx:for="{{item.items}}" wx:for-item="it" wx:key="name"
          data-url="{{it.url}}" bindtap="copy">
      <view class="item-title">{{it.name}}</view>
      <view class="item-desc">{{it.desc}}</view>
      <view class="item-url">{{it.url}}</view>
    </view>
  </view>

  <view class="footer-note">链接于 2026 年 9 月核验；海外站点访问速度取决于网络环境。</view>
</view>
