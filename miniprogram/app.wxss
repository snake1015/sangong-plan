/* ============================================================
   沪上三公规划 · 小程序全局样式（简洁 / 低龄友好 / 交互友好）
   配色与网站一致：暖奶油底 + 明亮蓝 + 大圆角
   ============================================================ */
page {
  background: #FBF8F3;
  color: #263243;
  font-size: 30rpx;
  line-height: 1.75;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

/* ---------- 通用容器 ---------- */
.page { padding: 24rpx 24rpx 60rpx; }
.hero {
  background: linear-gradient(135deg, #EAF3FF 0%, #F6F0FF 55%, #E9FBF3 100%);
  padding: 36rpx 28rpx 32rpx;
  border-bottom: 1rpx solid #E8EDF5;
}
.hero-title { font-size: 44rpx; font-weight: 800; margin-bottom: 12rpx; }
.hero-sub { color: #4A5866; font-size: 28rpx; }
.kicker {
  display: inline-block; background: #FFFFFF; border: 1rpx solid #E8EDF5;
  border-radius: 999rpx; padding: 6rpx 20rpx; font-size: 24rpx; color: #4A5866; margin-bottom: 16rpx;
}

.section { margin-top: 28rpx; }
.section-title { font-size: 34rpx; font-weight: 800; margin-bottom: 16rpx; }
.muted { color: #7A8797; }
.small { font-size: 25rpx; }
.center { text-align: center; }

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF; border: 1rpx solid #E8EDF5; border-radius: 32rpx;
  padding: 26rpx 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx -12rpx rgba(38, 50, 67, 0.28);
}
.card-title { font-size: 32rpx; font-weight: 800; margin-bottom: 10rpx; }
.card-row { display: flex; justify-content: space-between; align-items: center; }
.card-soft { background: #F4FCF8; border-color: #B9ECDD; }
.card-warn { background: #FFFBF2; border-color: #FFE0AE; }
.card-info { background: #F4F8FF; border-color: #D7E4FB; }

/* ---------- 胶囊 / 标签 ---------- */
.chip {
  display: inline-block; background: #FFFFFF; border: 1rpx solid #E8EDF5;
  border-radius: 999rpx; padding: 8rpx 22rpx; font-size: 25rpx; margin: 0 12rpx 12rpx 0;
}
.tag {
  display: inline-block; background: #EEF4FF; color: #2F6FE4; border-radius: 999rpx;
  padding: 4rpx 18rpx; font-size: 23rpx; font-weight: 700;
}

/* ---------- 按钮 ---------- */
.btn {
  display: block; text-align: center; border-radius: 999rpx; padding: 24rpx 0;
  font-size: 31rpx; font-weight: 700; background: #FFFFFF; color: #4A5866;
  border: 1rpx solid #E8EDF5; margin-bottom: 18rpx;
}
.btn-primary {
  background: linear-gradient(120deg, #4C8DFF, #7FB0FF); color: #FFFFFF; border: none;
  box-shadow: 0 14rpx 24rpx -16rpx rgba(76, 141, 255, 0.95);
}
.btn-mint { background: linear-gradient(120deg, #3FBF8F, #7FE0BC); color: #FFFFFF; border: none; }
.btn-sun { background: linear-gradient(120deg, #FFB443, #FFD08A); color: #7A4A00; border: none; }
.btn-sm { display: inline-block; padding: 14rpx 30rpx; font-size: 27rpx; margin: 0 12rpx 12rpx 0; }
.btn-line { display: inline-block; padding: 14rpx 30rpx; font-size: 27rpx; margin: 0 12rpx 12rpx 0; background: #FFFFFF; border: 1rpx solid #E8EDF5; border-radius: 999rpx; }
.btn[disabled] { opacity: 0.45; }

/* ---------- 首页三步走 ---------- */
.steps { display: flex; flex-direction: column; }
.step {
  background: linear-gradient(135deg, #F7FAFF, #FFFFFF);
  border: 2rpx solid #E8EDF5; border-radius: 28rpx; padding: 24rpx 26rpx; margin-bottom: 18rpx;
}
.step:active { transform: scale(0.99); }
.step-title { font-size: 31rpx; font-weight: 800; }
.step-desc { color: #7A8797; font-size: 25rpx; margin-top: 6rpx; }
.step:nth-child(1) { background: linear-gradient(135deg, #FFF6E8, #FFFFFF); }
.step:nth-child(3) { background: linear-gradient(135deg, #EDFBF4, #FFFFFF); }

/* ---------- 数据条 ---------- */
.stat-row { display: flex; gap: 16rpx; }
.stat {
  flex: 1; background: #FFFFFF; border: 1rpx solid #E8EDF5; border-radius: 26rpx;
  padding: 20rpx 16rpx; text-align: center;
}
.stat-num { font-size: 38rpx; font-weight: 800; color: #2F6FE4; }
.stat-label { font-size: 22rpx; color: #7A8797; margin-top: 6rpx; line-height: 1.5; }

/* ---------- 列表条目 ---------- */
.item {
  background: #FFFFFF; border: 1rpx solid #E8EDF5; border-radius: 26rpx;
  padding: 24rpx 26rpx; margin-bottom: 16rpx;
}
.item:active { background: #F7FAFF; }
.item-title { font-size: 30rpx; font-weight: 700; }
.item-desc { font-size: 25rpx; color: #7A8797; margin-top: 4rpx; }
.item-url { font-size: 22rpx; color: #9AA7B8; margin-top: 6rpx; word-break: break-all; }

/* ---------- 路线图 ---------- */
.stage-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.stage-dot {
  width: 60rpx; height: 60rpx; border-radius: 50%; color: #FFFFFF; font-weight: 800;
  display: flex; align-items: center; justify-content: center; font-size: 28rpx;
  background: linear-gradient(135deg, #4C8DFF, #83B3FF); flex: none;
}
.stage-dot.g1 { background: linear-gradient(135deg, #3FBF8F, #7FE0BC); }
.stage-dot.g2 { background: linear-gradient(135deg, #FFB443, #FFD08A); }
.stage-title { font-size: 31rpx; font-weight: 800; }
.stage-period { font-size: 24rpx; color: #7A8797; }
.goal {
  background: #F7FAFF; border: 2rpx dashed #C9DDFB; border-radius: 22rpx;
  padding: 18rpx 22rpx; margin: 14rpx 0; font-size: 27rpx;
}
.todo { display: flex; align-items: flex-start; gap: 14rpx; padding: 12rpx 0; }
.todo-box {
  width: 40rpx; height: 40rpx; border-radius: 12rpx; border: 3rpx solid #C9D8EC;
  flex: none; margin-top: 4rpx; text-align: center; line-height: 38rpx; font-size: 26rpx; color: #FFFFFF;
}
.todo-box.on { background: #4C8DFF; border-color: #4C8DFF; }
.todo-text { font-size: 28rpx; color: #263243; }
.todo-text.done { color: #9AA7B8; text-decoration: line-through; }
.note {
  background: #EFFBF7; border: 1rpx solid #B9ECDD; border-radius: 22rpx;
  padding: 18rpx 22rpx; margin-top: 14rpx; font-size: 26rpx; color: #1F5C50;
}
.progress-bar { height: 16rpx; background: #E8EEF9; border-radius: 999rpx; overflow: hidden; margin: 14rpx 0; }
.progress-bar-inner { height: 100%; background: linear-gradient(90deg, #4C8DFF, #7FB0FF); }

/* ---------- 三校切换 ---------- */
.tabs { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 20rpx; }
.tab {
  padding: 14rpx 28rpx; border-radius: 999rpx; background: #FFFFFF; border: 2rpx solid #E8EDF5;
  font-size: 27rpx; color: #4A5866; font-weight: 700;
}
.tab.active { background: linear-gradient(120deg, #4C8DFF, #7FB0FF); color: #FFFFFF; border-color: transparent; }
.kv { display: flex; padding: 12rpx 0; border-bottom: 1rpx solid #F0F4FA; }
.kv:last-child { border-bottom: none; }
.kv-k { width: 170rpx; flex: none; color: #7A8797; font-size: 26rpx; }
.kv-v { flex: 1; font-size: 27rpx; }

/* ---------- 练习（题库） ---------- */
.track-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.track {
  flex: 1; text-align: center; padding: 22rpx 12rpx; border-radius: 28rpx;
  border: 3rpx solid #E8EDF5; background: #FFFFFF; font-weight: 800; font-size: 29rpx; color: #4A5866;
}
.track.active { background: linear-gradient(120deg, #4C8DFF, #7FB0FF); color: #FFFFFF; border-color: transparent; }
.q-meta { display: flex; justify-content: space-between; align-items: center; font-size: 25rpx; color: #7A8797; }
.q-stem { font-size: 34rpx; font-weight: 700; line-height: 1.7; margin: 16rpx 0 18rpx; }
.q-opt {
  display: flex; align-items: center; gap: 18rpx; background: #FBFCFF; border: 3rpx solid #E8EDF5;
  border-radius: 28rpx; padding: 26rpx 24rpx; margin-bottom: 18rpx; font-size: 31rpx; min-height: 56rpx;
}
.q-opt.sel { border-color: #4C8DFF; background: #EEF4FF; }
.q-opt.ok { border-color: #3FBF8F; background: #F1FCF7; }
.q-opt.bad { border-color: #F0668A; background: #FFF3F6; }
.q-key {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #E9EFF8; color: #4A5866;
  font-weight: 800; display: flex; align-items: center; justify-content: center; flex: none; font-size: 28rpx;
}
.q-feedback { border-radius: 24rpx; padding: 22rpx 24rpx; font-size: 28rpx; margin-bottom: 18rpx; }
.q-feedback.ok { background: #F1FCF7; border: 2rpx solid #A8E6C9; }
.q-feedback.bad { background: #FFF3F6; border: 2rpx solid #FFC2D1; }
.stars { font-size: 56rpx; letter-spacing: 8rpx; }
.stars-off { color: #D8DFEA; }
.sheet { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; }
.sheet-btn {
  width: 68rpx; height: 62rpx; line-height: 62rpx; text-align: center; border-radius: 16rpx;
  background: #FFFFFF; border: 2rpx solid #E8EDF5; font-size: 25rpx;
}
.sheet-btn.done { background: #E4EEFF; border-color: #A9C7FF; }
.sheet-btn.cur { border-color: #4C8DFF; border-width: 3rpx; font-weight: 800; }
.review { border-top: 1rpx dashed #E8EDF5; padding: 18rpx 0; font-size: 27rpx; }
.history-row { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 1rpx solid #F0F4FA; font-size: 26rpx; }

/* ---------- 免责 ---------- */
.disclaimer { font-size: 26rpx; color: #4A5866; margin-bottom: 12rpx; }
.footer-note { text-align: center; color: #9AA7B8; font-size: 23rpx; margin-top: 30rpx; }
